[Unit]
Description=Mine Voice LoRa Node M2
After=sound.target local-fs.target
Wants=sound.target

[Service]
Type=simple
User=zlm
Group=zlm
WorkingDirectory=/home/zlm/mine-voice
ExecStart=/home/zlm/mine-voice/.venv/bin/python /home/zlm/mine-voice/main.py --config /home/zlm/mine-voice/config.json
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
